@using UzmanEgitimDanismanim.Shared.Dtos
@using UzmanEgitimDanismanim.Shared.Common
@model List<OgrenciDokumanDto>


<div class="row">
    <div class="col-md-12">
        <div class="card card-warning">
            <div class="card-header">
                <h3 class="card-title">Danışman Raporu Ekle</h3>
                <div class="card-tools">
                    <button type="button" class="btn btn-tool" data-card-widget="collapse">
                        <i class="fas fa-minus"></i>
                    </button>
                    <button type="button" class="btn btn-tool" data-card-widget="remove">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>
            <div class="card-body">
                <div class="row">

                    <form asp-action="DanismanRaporuEkle" class="cmxform form-horizontal tasi-form col-md-12" method="post" enctype="multipart/form-data">
                        <input id="OgrenciId" name="OgrenciId" type="hidden" value="@ViewBag.OgrenciNo" />
                        <div class="form-group row">

                            <div class="col-md-4">
                                <label>Danışman Raporu  (Doc, Docx veya PDF)</label>
                            </div>

                            <div class="col-md-6">
                                <input type="file" class="form-control" name="Dosya" required />
                            </div>

                            <div class="col-md-2">
                                <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-save"></i> Kaydet</button>
                            </div>
                        </div>
                    </form>

                </div>
            </div>
            <!-- /.card-body -->
        </div>
        <!-- /.card -->
    </div>
</div>



@if (Model.Count>0)
{
<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">Danışman Raporları</h3>

        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
            <button type="button" class="btn btn-tool" data-card-widget="remove">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    <div class="card-body" id="dersGrafikChartContent">

        <table class="table table-bordered table-hover">
            <thead>
                <tr>
                    <th>Dokuman Adı</th>
                    <th>Danışman Raporu</th>
                    <th>Ekleme Tarihi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="gradeX" data-widget="expandable-table" aria-expanded="false">
                        <td>@Html.DisplayFor(modelItem => item.DokumanAdi)</td>
                        <td>
                            <a href="~/Panel/Files/Danisman-Raporu/@Html.DisplayFor(modelItem => item.Dokuman)" target="_blank">@item.Dokuman</a>
                        </td>
                        <td>@item.IslemTarihi.ToString("dd MMMM yyyy")</td>
                    </tr>
                }
            </tbody>
        </table>


    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->
}
@model UzmanEgitimDanismanim.Shared.ViewModels.OgrenciListeleViewModel
@using System.Security.Claims
@using UzmanEgitimDanismanim.Shared.Common

@{
    ViewData["Title"] = "Danışman Panel - Öğrenci Listesi";
}


<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Öğrenci Listesi</h1>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-right">
                    <li> <a class="btn btn-primary btn-block" data-toggle="modal" href="OgrenciEkle">Öğrenci Ekle</a></li>
                </ol>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>


<div class="row">
    <div class="col-lg-12">
        <section class="card">
            <div class="card-body">
                <form asp-action="OgrenciListele" class="cmxform form-horizontal tasi-form" method="post">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label asp-for="araViewModel.Ad"></label>
                            <input asp-for="araViewModel.Ad" type="text" class="form-control" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label asp-for="araViewModel.Soyad"></label>
                            <input asp-for="araViewModel.Soyad" type="text" class="form-control" />
                        </div>

                        <div class="col-md-4 mt-4" style="padding-top:8px;">
                            <button type="submit" class="btn btn-primary btn-block"><i class="fa fa-search"></i> Sorgula</button>
                        </div>
                    </div>
                    <input hidden id="hfCurrentPageIndex" name="araViewModel.request.page" value="0" />
                </form>
            </div>
        </section>
    </div>
</div>


<div class="card">
    <div class="card-body p-0">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Soyad</th>
                    <th>Telefon</th>
                    <th>Eposta</th>
                    <th>Detay</th>
                     <th>Sil</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Model.Items)
                {
                    <tr class="gradeX">
                        <td>@Html.DisplayFor(modelItem => item.Ogrenci.Ad)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ogrenci.Soyad)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ogrenci.CepTelefonu)</td>
                        <td>@Html.DisplayFor(modelItem => item.Ogrenci.Eposta)</td>
                        <td>
                            <a href="@Url.Action("OgrenciDetay", new { id = item.EncryptedId })" class="btn btn-sm btn-info btn-block">
                                <i class="fas fa-user"></i> Detay
                            </a>
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-danger btn-block" data-href="OgrenciSil?id=@item.EncryptedId" data-toggle="modal" data-target="#confirm-delete"><i class="fa fa-trash"></i> Sil</button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


        <div class="row pt-3">
            <div class="col-sm-12 col-md-3">
                <div class="dataTables_info p-2">Toplam kayıt @Model.PageInfo.TotalItems</div>
            </div>
            <div class="col-sm-12 col-md-9">
                <div class="dataTables_paginate paging_bootstrap pagination" style="justify-content: flex-end;">
                    <ul class="pagination">
                        @Html.PageLinks(@Model.PageInfo, x => Url.Action("OgrenciListele", new { page = x.ToString() }))
                    </ul>
                </div>
            </div>
        </div>

    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->
<script type="text/javascript">
    $(document).ready(function () {

        DenemeTuru();

        $("#selectSinavId").change(function(){
            DenemeTuru();
        });

        $("#inputSinavAdi").on("input", function(){
            $('#lgsSinavAdi').val($('#inputSinavAdi').val());
            $('#tytSinavAdi').val($('#inputSinavAdi').val());
            $('#aytSinavAdi').val($('#inputSinavAdi').val());
        });

        $("#inputCozumTarihi").on("input", function(){
            $('#lgsCozumTarihi').val($('#inputCozumTarihi').val());
            $('#tytCozumTarihi').val($('#inputCozumTarihi').val());
            $('#aytCozumTarihi').val($('#inputCozumTarihi').val());
        });

        $("#selectZorlukSeviyesi").on("change", function() {
            $('#lgsZorlukSeviyesi').val($('#selectZorlukSeviyesi').val());
            $('#tytZorlukSeviyesi').val($('#selectZorlukSeviyesi').val());
            $('#aytZorlukSeviyesi').val($('#selectZorlukSeviyesi').val());
        });

    });

    function DenemeTuru(){
        switch($("#selectSinavId").val()){
            case "3":
                $("#lgsForm").css('display','block');
                $("#tytForm").css('display','none');
                $("#aytForm").css('display','none');
                break;
            case "4":
                $("#lgsForm").css('display','none');
                $("#tytForm").css('display','block');
                $("#aytForm").css('display','none');
                break;
            case "5":
                $("#lgsForm").css('display','none');
                $("#tytForm").css('display','none');
                $("#aytForm").css('display','block');
                break;
        }
    };
</script>
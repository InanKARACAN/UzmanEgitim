@using UzmanEgitimDanismanim.Shared.Dtos.CustomDtos
@using System.Security.Claims
@model List<CalenderDto>

@{
    ViewData["Title"] = "Danışman Panel - Görev Takip";
}

<!-- fullCalendar -->
<link rel="stylesheet" href="/Panel/plugins/fullcalendar/main.css">

<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Görev Takip</h1>
            </div>

        </div>
    </div><!-- /.container-fluid -->
</section>




<div class="row">

    <div class="col-md-12">
        <div class="card card-primary">
            <div class="card-body p-0">
                <!-- THE CALENDAR -->
                <div id="calendar"></div>
            </div>
            <!-- /.card-body -->

        </div>
    </div>
    <!-- /.col -->
    <!-- jQuery -->
    <script type="text/javascript" src="/Panel/plugins/jquery/jquery.min.js"></script>
    <!-- fullCalendar 2.2.5 -->
    <script type="text/javascript" src="/Panel/plugins/moment/moment.min.js"></script>
   
    <script type="text/javascript" src="/Panel/plugins/fullcalendar/main.js"></script>
     <script type="text/javascript" src="/Panel/plugins/fullcalendar/locales/tr.js"></script>

</div>



<!-- Modal -->
<div class="modal fade " id="modalGorevTakipEkle" tabindex="-1" role="dialog" aria-labelledby="modalGorevTakipLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalGorevTakip">Görev Ekle</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">

                <form asp-action="OgrenciGorevTakipEkle" method="post">
                    <input name="OgrenciID" value="@User.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Sid).Value" type="hidden" />
                    <div class="row">
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Başlık</label>
                                <input type="text" name="Baslik" id="Baslik" class="form-control" required />
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Tarih</label>
                                <input type="text" name="GorevBaslangic" id="GorevBaslangic" class="form-control" readonly />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-sm-6">

                            <div class="form-group">
                                <label>Başlangıç Saat</label>
                                <div class="input-group date" id="saat" data-target-input="nearest">
                                    <input type="text" id="BaslangicSaat" name="BaslangicSaat" class="form-control datetimepicker-input" data-target="#saat"
                                    data-inputmask='"mask": "99:99"' data-mask />
                                    <div class="input-group-append" data-target="#saat" data-toggle="datetimepicker">
                                        <div class="input-group-text"><i class="fa fa-clock"></i></div>
                                    </div>
                                </div>
                                <!-- /.input group -->
                            </div>
                        </div>
                        <div class="col-sm-6">
                            <div class="form-group">
                                <label>Bitiş Saat</label>
                                <div class="input-group date" id="saat2" data-target-input="nearest">
                                    <input type="text" id="BitisSaat" name="BitisSaat" class="form-control datetimepicker-input" data-target="#saat2" 
                                    data-inputmask='"mask": "99:99"' data-mask />
                                    <div class="input-group-append" data-target="#saat2" data-toggle="datetimepicker">
                                        <div class="input-group-text"><i class="fa fa-clock"></i></div>
                                    </div>
                                </div>
                                <!-- /.input group -->
                            </div>



                        </div>
                    </div>
                    <div class="row float-right">
                        <button type="submit" class="btn btn-primary">Görev Ekle</button>
                    </div>

                </form>
            </div>
        </div>
    </div>
</div>
<!-- modal -->


<div id="calendarModal" class="modal fade">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h4 id="modalTitle" class="modal-title"></h4>
                <button type="button" class="close" data-dismiss="modal"><span aria-hidden="true">×</span> <span class="sr-only">close</span></button>
            </div>
            <div id="modalBody" class="modal-body"> </div>
            <div class="modal-footer">
                <a id="tamamladi" class="btn btn-success">Tamamladı</a>
                <a id="tamamlamadi" class="btn btn-info">Tamamlamadı</a>
                <a id="sil" class="btn btn-danger">Sil</a>
            </div>
        </div>
    </div>
</div>
<!-- Page specific script -->
<script>
        $(function () {

          /* initialize the external events
           -----------------------------------------------------------------*/
          function ini_events(ele) {
            ele.each(function () {

              // create an Event Object (https://fullcalendar.io/docs/event-object)
              // it doesn't need to have a start or end
              var eventObject = {
                title: $.trim($(this).text()) // use the element's text as the event title
              }

              // store the Event Object in the DOM element so we can get to it later
              $(this).data('eventObject', eventObject)



            })
          }

          ini_events($('#external-events div.external-event'))

          /* initialize the calendar
           -----------------------------------------------------------------*/
          //Date for the calendar events (dummy data)
          var date = new Date()
          var d    = date.getDate(),
              m    = date.getMonth(),
              y    = date.getFullYear()

          var Calendar = FullCalendar.Calendar;

          var containerEl = document.getElementById('external-events');
          var checkbox = document.getElementById('drop-remove');
          var calendarEl = document.getElementById('calendar');

          // initialize the external events
          // -----------------------------------------------------------------


          var calendar = new Calendar(calendarEl, {
              locale:'tr',
              dateClick: function(info) {
                var eventDate =  moment(info.date).format("DD.MM.YYYY");
                $('#GorevBaslangic').val(eventDate);
              $('#modalGorevTakipEkle').modal();
            },
            eventClick: function (info) {
                $('#modalTitle').html(info.event.title);
                $('#modalBody').html('<b>Tarih:</b> ' + moment(info.event.startStr).format("DD.MM.YYYY") + '</br>' +
                    '<b>Başlangıç Saat:</b> ' + moment(info.event.startStr).format("HH:mm") + '</br>' +
                    '<b>Bitiş Saat:</b> ' + moment(info.event.endStr).format("HH:mm") + '</br>' +
                    '<b>Durum:</b> ' + info.event.overlap
                    );
                
                if (info.event.overlap == 'Yeni') {
                    $('#tamamladi').attr('href', 'GorevTakip/OgrenciGorevTakipTamamladi?id=' + info.event.id);
                    $('#tamamlamadi').attr('href', 'GorevTakip/OgrenciGorevTakipTamamlamadi?id=' + info.event.id);

                    if (info.event.groupId == 'true') {
                        $('#sil').attr('href', 'GorevTakip/OgrenciGorevTakipSil?id=' + info.event.id);
                    } else {
                        $('#sil').css("display", "none");
                    }

                } else { 
                    $('#tamamladi').css("display", "none");
                    $('#tamamlamadi').css("display", "none");
                    $('#sil').css("display", "none");
                }

                $('#calendarModal').modal();
            },
            //   eventClick: function(info) {
            //   //var eventDate = info.event.start;
            //   console.log(info.event);
            //   alert(info.event.title + " - " + info.event.startStr + " - " + info.event.endStr);
            //   //example output: "Wed Oct 02 2019 00:00:00 GMT-0600 (Central Standard Time)"
            // },
            
            headerToolbar: {
              left  : 'prev,next today',
              center: 'title',
              right : 'dayGridMonth,timeGridWeek,timeGridDay'
            },
            themeSystem: 'bootstrap',
            //Random default events
            events: @Html.Raw(Json.Serialize(Model)),
            editable  : false,
            droppable : false, // this allows things to be dropped onto the calendar !!!
            drop      : function(info) {
              // is the "remove after drop" checkbox checked?
              if (checkbox.checked) {
                // if so, remove the element from the "Draggable Events" list
                info.draggedEl.parentNode.removeChild(info.draggedEl);
              }
            },
          });

          calendar.render();
          // $('#calendar').fullCalendar()


        })
</script>
@using UzmanEgitimDanismanim.Shared.Dtos
@model List<OgrenciDokumanDto>

@{
    ViewData["Title"] = "Danışman Panel - Kaynak Önerisi";
}


<!-- Content Header (Page header) -->
<section class="content-header">
    <div class="container-fluid">
        <div class="row mb-2">
            <div class="col-sm-6">
                <h1>Kaynak Önerisi</h1>
            </div>
        </div>
    </div><!-- /.container-fluid -->
</section>

@if (Model.Count>0)
{
<div class="card card-danger">
    <div class="card-header">
        <h3 class="card-title">Kaynak Önerileri</h3>

        <div class="card-tools">
            <button type="button" class="btn btn-tool" data-card-widget="collapse">
                <i class="fas fa-minus"></i>
            </button>
            <button type="button" class="btn btn-tool" data-card-widget="remove">
                <i class="fas fa-times"></i>
            </button>
        </div>
    </div>
    <div class="card-body" id="dersGrafikChartContent">

        <table class="table table-bordered table-hover">
            <tbody>
                @foreach (var item in Model)
                {
                    <tr class="gradeX" data-widget="expandable-table" aria-expanded="false">
                        <td>@Html.DisplayFor(modelItem => item.DokumanAdi)</td>
                    </tr>
                }
            </tbody>
        </table>


    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->
}